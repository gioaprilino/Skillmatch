# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/skillmatch?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-super-secret-key-min-32-chars-change-in-production"

# Email (Resend/SendGrid)
EMAIL_SERVER_HOST="smtp.resend.com"
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER="resend"
EMAIL_SERVER_PASSWORD="re_xxxxxxxxxxxx"
EMAIL_FROM="SkillMatch <noreply@skillmatch.id>"

# WhatsApp OTP (Twilio/Vonage)
WHATSAPP_PROVIDER="twilio"
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="your_auth_token"
TWILIO_PHONE_NUMBER="+15551234567"

# Google OAuth
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-xxxxxxxxxxxxxxxxxxxxxxxx"

# Redis (Upstash)
UPSTASH_REDIS_REST_URL="https://xxxxx.upstash.io"
UPSTASH_REDIS_REST_TOKEN="xxxxxxxxxxxxxxxxxxxxxxxx"

# IPFS (Pinata)
PINATA_JWT="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
PINATA_GATEWAY="https://gateway.pinata.cloud/ipfs/"

# Verifiable Credentials
VC_ISSUER_DID="did:web:skillmatch.id"
VC_ISSUER_PRIVATE_KEY_MULTIBASE="zrv2ov6pnBHTaxHecERnp78Q5ebwpsvvPnZV2KdYbNGSkwjujRfn3nPsjjvaJ3A171bbJvU7F1uDNDDhxkYtTEXNUWD"
VC_ISSUER_PUBLIC_KEY_MULTIBASE="z6MkiZ5TciFcbLfJn2cKpHQTvq3TFGuyc7J8ARg2jGHx4Lwb"
# Legacy base58 (without 'z' prefix) - for backward compatibility
VC_ISSUER_PRIVATE_KEY="rv2ov6pnBHTaxHecERnp78Q5ebwpsvvPnZV2KdYbNGSkwjujRfn3nPsjjvaJ3A171bbJvU7F1uDNDDhxkYtTEXNUWD"
VC_ISSUER_PUBLIC_KEY="6MkiZ5TciFcbLfJn2cKpHQTvq3TFGuyc7J8ARg2jGHx4Lwb"

# File Upload
UPLOAD_MAX_SIZE="5242880"
UPLOAD_ALLOWED_TYPES="image/jpeg,image/png,application/pdf"

# Analytics
NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"
SENTRY_DSN="https://xxxxx@sentry.io/xxxxx"

# Feature Flags
NEXT_PUBLIC_ENABLE_PWA="true"
NEXT_PUBLIC_ENABLE_VOICE="true"
NEXT_PUBLIC_ENABLE_OFFLINE="true"